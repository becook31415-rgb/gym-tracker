  "program_notes": [
    {
      "title": "How to progress",
      "body": "Stay inside the RPE range. When every set reaches the top of the rep range at the target RPE, add the smallest available load next session (2.5 kg for barbell lifts, the next dumbbell up for DB work)."
    },
    {
      "title": "RPE guide",
      "body": "RPE 10 = nothing left. RPE 9 = one rep left. RPE 8 = two reps left. RPE 7 = three reps left, bar speed still good."
    },
    {
      "title": "Warm-up",
      "body": "5 minutes easy cardio, then 2-3 ramp-up sets before the first main lift. Accessories need no warm-up sets."
    },
    {
      "title": "Accessory block",
      "body": "Accessories without their own prescription use 2 x 12-15 at the RPE shown for that day."
    }
  ],
